{
  "name": "boate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "planta": "node tools/make-layout.mjs",
    "otimizar": "node tools/optimize-glb.mjs blender/export/boate_raw.glb public/models/boate.glb",
    "publicar": "node tools/publish-pages.mjs",
    "conferir": "node tools/check-layout.mjs",
    "typecheck": "tsc --noEmit",
    "personagens": "node tools/build-characters.mjs"
  },
  "dependencies": {
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "0.35.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
