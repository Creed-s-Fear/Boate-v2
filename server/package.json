{
  "name": "boate-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "env:init": "node --import tsx scripts/init-env.ts",
    "db:up": "docker compose up -d db",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "airdrop": "node --env-file=.env --import tsx scripts/airdrop.ts",
    "sweep": "node --env-file=.env --import tsx scripts/sweep.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@node-rs/argon2": "2.2.2",
    "@solana/web3.js": "1.98.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
